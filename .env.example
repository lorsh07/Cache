# Claude API 키. 비워두면 내장 카탈로그 기반 추천으로 동작합니다.
ANTHROPIC_API_KEY=
PORT=8787

# 표지 자동 검색 (모두 선택)
# 영화·드라마 포스터: https://www.themoviedb.org/settings/api 에서 발급 (v3 키 또는 v4 읽기 토큰)
TMDB_API_KEY=
# 한국어 책 표지: https://developers.kakao.com 앱의 REST API 키
KAKAO_REST_API_KEY=
# Google Books 키 (없어도 되지만 키 없이 쓰면 하루 한도에 걸릴 수 있음)
GOOGLE_BOOKS_API_KEY=
