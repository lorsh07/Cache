# Firebase project config (Google 로그인 포함 인증 기능에 필요)
# 1. https://console.firebase.google.com 에서 새 프로젝트 생성
# 2. 프로젝트 설정 > 일반 > 내 앱 > 웹 앱 추가 후 아래 값 복사
# 3. Authentication > Sign-in method 에서 "Google" 과 "이메일/비밀번호" 제공업체 사용 설정
# 4. Authentication > Settings > 승인된 도메인에 localhost 및 배포 도메인 추가
# 5. 이 파일을 .env.local 로 복사하고 실제 값을 채워넣기 (.env.local 은 git에 커밋되지 않음)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
